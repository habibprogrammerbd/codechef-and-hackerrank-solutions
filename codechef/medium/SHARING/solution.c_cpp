#include <bits/stdc++.h>
using namespace std;

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int a, b;
    cin >> a >> b;

    if (a % 2 == 0 && b % 2 == 0)
    {
        cout << (a - b) - b << endl;
    }
    else if (a % 2 != 0 && b % 2 != 0)
    {
        cout <<(a - b) - b << endl;
    }
    else
    {
        cout << -1 << endl;
    }
    return 0;
}